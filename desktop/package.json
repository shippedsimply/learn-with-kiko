{
  "name": "learn-with-kiko",
  "productName": "Learn with Kiko",
  "version": "1.0.0",
  "description": "Learn with Kiko: reading, writing, maths and more. Kiko by Lathan.",
  "author": "Lathan",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.learnwithkiko.desktop",
    "productName": "Learn with Kiko",
    "copyright": "Kiko by Lathan",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "tts.js",
      "app/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Learn with Kiko",
      "artifactName": "Learn-with-Kiko-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Learn-with-Kiko-Portable-${version}.exe"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "tts",
        "to": "tts",
        "filter": [
          "kokoro.onnx",
          "af_heart.bin",
          "vocab.json"
        ]
      }
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "onnxruntime-node": "^1.31.1",
    "phonemizer": "^1.2.1"
  }
}
